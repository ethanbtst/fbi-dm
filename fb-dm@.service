[Unit]
Description=TUI display manager with images
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@%i.service
Conflicts=getty@%i.service

[Service]
Type=idle
ExecStart=/opt/fb-dm/fb-dm
StandardInput=tty
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
Restart=always

[Install]
WantedBy=multi-user.target